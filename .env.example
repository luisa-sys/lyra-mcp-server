# Lyra MCP Server Environment Variables
# Copy to .env and fill in values

# Supabase connection
SUPABASE_URL=https://ilprytcrnqyrsbsrfujj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Transport: 'http' (default) or 'stdio'
MCP_TRANSPORT=http

# HTTP server port (only used when MCP_TRANSPORT=http)
PORT=3001

# KAN-328 — access model v2. When 'true', gated tools require the caller to be
# user_status='live' AND not suspended, and per-feature defaults follow the
# access_tier tier model (test features on for 'beta', off for 'prod'; GA
# features always on). Leave UNSET/false on any environment whose `profiles`
# table does not yet have the user_status/access_tier columns (e.g. production
# until the KAN-327 schema migration is promoted there). Default: off.
ACCESS_MODEL_V2=false
